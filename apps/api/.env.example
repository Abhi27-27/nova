# ---------------------------------------------------------------------------
# NOVA API — environment
# Copy to `.env` and fill in. Every variable is validated at boot by src/config/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local Docker:  postgresql://nova:nova@localhost:5432/nova?schema=public
# Neon/Supabase: paste the pooled connection string (must include sslmode=require)
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova?schema=public"

# Secrets — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string-32-chars"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Public URL of the web client; used to build invitation links.
WEB_APP_URL=http://localhost:3000

# Cookie behaviour. Set COOKIE_SECURE=true and COOKIE_SAME_SITE=none when the API
# and the web app are served from different sites over HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

LOG_LEVEL=debug

# Demo credentials created by `npm run db:seed`
SEED_PASSWORD=Password123
