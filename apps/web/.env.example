# Base URL of the NOVA API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Optional. When set, Next.js proxies /api/v1/* to this origin so the browser only
# ever talks to its own origin and the auth cookies stay first-party. Use this when
# the web app and the API are deployed to different domains.
# API_PROXY_TARGET=https://nova-api.onrender.com
