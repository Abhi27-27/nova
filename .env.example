# ---------------------------------------------------------------------------
# NOVA — where the environment lives
#
# This file is a pointer, not a config. Each app owns its own environment:
#
#   apps/api/.env         copy from apps/api/.env.example
#   apps/web/.env.local   copy from apps/web/.env.example
#
# Quick start:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local
#
# Generate the API secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
